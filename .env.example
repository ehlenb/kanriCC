# Supabase — get from your project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — server-side only, never expose on frontend
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — candidate profile embeddings (Wave 2 retrieval). Server-side
# only. Without this, embedding generation and semantic search no-op safely
# and matching falls back to full-text search alone.
VOYAGE_API_KEY=pa-...
